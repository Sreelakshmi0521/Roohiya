<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/user/common.css">
  <link rel="stylesheet" href="/styles/user/<%= pagecss %>">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
</head>
<body>
  <%- include('partials/user/navbar') %>
  <!-- HERO -->
  <section class="hero">
    <% if (hero) { %>
      <div class="hero-content">
        <h1><%= hero.title %></h1>
        <p><%= hero.description %></p>
        <a href="<%= hero.shopLink || '/shop' %>" class="shop-now-btn">Shop Now</a>
      </div>
      <div class="hero-image">
        <img src="<%= hero.image %>" alt="<%= hero.alt || 'Hero Image' %>">
      </div>
    <% } else { %>
      <div class="hero-content">
        <h1>Adorn your soul with timeless beauty</h1>
        <p>Discover exquisite jewelry that complements every moment.</p>
        <a href="/user/shop" class="shop-now-btn">Shop Now</a>
      </div>
      <div class="hero-image">
        <img src="/images/hero-woman.jpg" alt="Woman wearing earrings">
      </div>
    <% } %>
  </section>

  <!-- CATEGORIES -->
  <section class="section">
    <div class="section-header">
      <h2>Browse Categories</h2>
      <p>Find the perfect jewelry for every occasion</p>
    </div>
    <div class="categories-grid">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(category => { %>
          <div class="category-card">
            <img src="<%= category.image || '/images/placeholder-category.jpg' %>" 
                 alt="<%= category.name || 'Category' %>">
            <div class="category-overlay">
              <h3 class="category-title"><%= category.name %></h3>
              <a href="/user/shop?category=<%= category._id %>" class="category-link">
                Explore <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-gem"></i>
          <h3>No categories available</h3>
          <p>Check back soon for new collections</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- NEW ARRIVALS -->
  <section class="section new-arrivals-section">
    <div class="section-header">
      <h2>New Arrivals</h2>
      <p>Discover our latest jewelry collections</p>
    </div>

    <div class="new-arrivals-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { 
             const displayVariant = product.variants && product.variants.length > 0 
               ? (product.variants.find(v => v.isListed && v.stock > 0) || product.variants[0])
               : null;
        %>
          <div class="product-card">
            <div class="product-image-container">
              <a href="/user/product/<%= product._id %>" class="product-image-link">
                <img 
                  src="<%= (displayVariant && displayVariant.images && displayVariant.images.length > 0) 
                          ? displayVariant.images[0] 
                          : '/images/placeholder.jpg' %>" 
                  alt="<%= product.name %>">
              </a>
              <div class="product-actions">
  <!-- Wishlist Button -->
 <button 
  class="wishlist-btn" 
  data-product-id="<%= product._id %>" 
  data-variant-id="<%= displayVariant ? displayVariant._id : '' %>"
  title="Add to Wishlist">
  <i class="far fa-heart"></i>
</button>

  <!-- Quick View Button -->
  <button class="quick-view-btn" 
          title="Quick View"
          onclick="window.location.href='/user/product/<%= product._id %>'">
    <i class="fas fa-eye"></i>
  </button>
</div>

<!-- 
              <% if (!product.isAvailable) { %>
                <span class="out-of-stock">Out of Stock</span>
              <% } %> -->
            </div>

            <div class="product-info">
              <a href="/user/product/<%= product._id %>" class="product-name-link">
                <h3><%= product.name %></h3>
              </a>

              <% if (product.isAvailable) { %>
                <div class="price-container">
                  <p class="product-price">₹<%= displayVariant.discountedPrice || displayVariant.price %></p>
                  <% if (displayVariant.discountedPrice && displayVariant.discountedPrice < displayVariant.price) { %>
                    <p class="original-price">₹<%= displayVariant.price %></p>
                  <% } %>
                </div>
                <p class="product-color">Color: <%= displayVariant.color || '-' %></p>

              

              <% } else { %>
                <p class="product-price">Unavailable</p>
                <p class="product-color">Color: -</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-box-open"></i>
          <h3>No new arrivals</h3>
          <p>Check back soon for our latest collections</p>
        </div>
      <% } %>
    </div>
  </section>
<%- include('partials/user/footer') %>

  
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</body>
</html>
