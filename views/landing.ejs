<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Roohiya - Timeless Jewelry' %></title>
  <link rel="stylesheet" href="/styles/user/common.css">
    <link rel="stylesheet" href="/styles/user/landing.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>
<body>

  <%- include('partials/user/navbar') %>
<!-- Hero Carousel (Dynamic) -->
<section class="hero-section">
  <div class="carousel">
    <!-- Slides -->
    <% heroSlides.forEach((slide, index) => { %>
      <div class="carousel-slide <%= index === 0 ? 'active' : '' %>"
           style="background-image: url('<%= slide.image %>');"
           alt="<%= slide.alt || 'Hero Image' %>">
      </div>
    <% }) %>

    <!-- Overlays (one per slide for dynamic text) -->
    <% heroSlides.forEach((slide, index) => { %>
      <div class="hero-overlay <%= index === 0 ? 'active' : '' %>">
        <h1><%= slide.title %></h1>
        <p><%= slide.description %></p>
        <a href="<%= slide.shopLink %>" class="btn-primary">Explore Collection</a>
      </div>
    <% }) %>

    <!-- Indicators -->
    <div class="carousel-indicators">
      <% heroSlides.forEach((slide, index) => { %>
        <div class="indicator <%= index === 0 ? 'active' : '' %>"
     data-slide-index="<%= index %>"></div>
      <% }) %>
    </div>
  </div>
</section>

  <!-- Categories -->
  <section class="categories-section">
    <h2 class="section-title">Shop by Category</h2>
    <div class="categories-grid">
      <a href="/user/shop?category=casual" class="category-card">
        <img src="https://res.cloudinary.com/dqcd6e4ux/image/upload/v1766914666/casual_wear_siy2ua.jpg" alt="Casual Wear">
        <div class="category-overlay">
          <h3>Casual Wear</h3>
       
        </div>
      </a>
      <a href="/user/shop?category=office" class="category-card">
        <img src="https://res.cloudinary.com/dqcd6e4ux/image/upload/v1766914777/office_wear_blhqqe.jpg" alt="Office Wear">
        <div class="category-overlay">
          <h3>Office Wear</h3>
        </div>
      </a>
      <a href="/user/shop?category=traditional" class="category-card">
        <img src="https://res.cloudinary.com/dqcd6e4ux/image/upload/v1766914872/tradition_wear_wjajg5.jpg" alt="Traditional Wear">
        <div class="category-overlay">
          <h3>Traditional Wear</h3>
        </div>
      </a>
    </div>
  </section>
<!-- New Arrivals - Final Perfect Version -->
<section class="new-arrivals">
  <h2 class="section-title">New Arrivals</h2>

  <% if (products && products.length > 0) { %>
    <div class="products-grid">
      <% products.forEach(product => { %>
        <div class="product-card">
          
          <!-- Clickable Image -->
          <a href="/user/product/<%= product._id %>" class="product-image-wrapper">
            <% 
              let displayImage = '';
              if (product.variants && product.variants.length > 0) {
                const variantWithImage = product.variants.find(v => v.images && v.images.length > 0);
                if (variantWithImage && variantWithImage.images[0]) {
                  displayImage = variantWithImage.images[0];
                }
              }
            %>
            <img src="<%= displayImage %>" alt="<%= product.name || 'Jewelry' %>">
          </a>

         
          <!-- Product Info -->
          <div class="product-info">
            <h4><%= product.name || 'Unnamed Product' %></h4>

            <!-- Price Logic Based on Your Model -->
            <% 
              let originalPrice = null;
              let discountedPrice = null;
              let hasDiscount = false;

              if (product.variants && product.variants.length > 0) {
                // Get all valid prices from variants
                const validVariants = product.variants.filter(v => v.isListed !== false);

                if (validVariants.length > 0) {
                  // Highest original price (for strikethrough)
                  originalPrice = Math.max(...validVariants.map(v => v.price));

                  // Lowest discounted price (if any variant has discount)
                  const discountedVariants = validVariants.filter(v => v.discountedPrice && v.discountedPrice < v.price);
                  if (discountedVariants.length > 0) {
                    discountedPrice = Math.min(...discountedVariants.map(v => v.discountedPrice));
                    hasDiscount = true;
                  } else {
                    // No discount → just use lowest regular price
                    discountedPrice = Math.min(...validVariants.map(v => v.price));
                  }
                }
              }
            %>

            <div class="price-display">
              <% if (hasDiscount) { %>
                <!-- Discounted: Big gold + small gray crossed -->
                <span class="discounted-price">₹<%= discountedPrice.toLocaleString('en-IN') %></span>
                <span class="original-price">₹<%= originalPrice.toLocaleString('en-IN') %></span>
              <% } else { %>
                <!-- Regular price -->
                <span class="regular-price">₹<%= (discountedPrice || originalPrice || 0).toLocaleString('en-IN') %></span>
              <% } %>
            </div>
          </div>

          <!-- SALE Badge (only if has discount) -->
          <% if (hasDiscount) { %>
            <div class="sale-badge">SALE</div>
          <% } %>

        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="text-align:center; color:var(--text-light); font-size:1.3rem; padding: 3rem 0;">
      No new arrivals yet. Check back soon!
    </p>
  <% } %>
</section>

<!-- Features Section - Elegant Boxed Design -->
<section class="features-section">
  <div class="features-container">
    <div class="features-grid">
      <div class="feature">
        <i class="fas fa-shipping-fast"></i>
        <h3>Free Shipping</h3>
        <p>On orders above ₹599</p>
      </div>
      <div class="feature">
        <i class="fas fa-shield-alt"></i>
        <h3>Quality Assured</h3>
        <p>100% Authentic Materials</p>
      </div>
      <div class="feature">
        <i class="fas fa-exchange-alt"></i>
        <h3>Easy Returns</h3>
        <p>10-Day Return Policy</p>
      </div>
      <div class="feature">
        <i class="fas fa-headset"></i>
        <h3>24/7 Support</h3>
        <p>Dedicated Customer Care</p>
      </div>
    </div>
  </div>
</section>
  <%- include('partials/user/footer') %>
 <script src="/js/carousel.js"></script>
</body>
</html>