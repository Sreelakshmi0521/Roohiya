<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/user/landing.css">
</head>
<body>
  <%- include('../partials/user/navbar') %>

<!-- HERO -->
<section class="hero">
  <% if (hero) { %>
    <div class="hero-content">
      <h1><%= hero.title %></h1>
      <p><%= hero.description %></p>
      <a href="<%= hero.shopLink || '/shop' %>" class="shop-now-btn">Shop Now</a>
    </div>
    <div class="hero-image">
      <img src="<%= hero.image %>" alt="<%= hero.alt || 'Hero Image' %>">
    </div>
  <% } else { %>
    <div class="hero-content">
      <h1>Adorn your soul with timeless beauty</h1>
      <p>Discover exquisite jewelry that complements every moment.</p>
      <a href="/shop" class="shop-now-btn">Shop Now</a>
    </div>
    <div class="hero-image">
      <img src="/images/hero-woman.jpg" alt="Woman wearing earrings">
    </div>
  <% } %>
</section>
<!-- CATEGORIES -->
<section class="section">
  <div class="section-header">
    <h2>Browse Categories</h2>
    <p>Find the perfect jewelry for every occasion</p>
  </div>
  <div class="categories-grid">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <div class="category-card">
          <img src="<%= category.image %>" alt="<%= category._doc.name || 'Category' %>">
          <div class="category-overlay">
            <h3 class="category-title">
              <% 
                // Access the name from _doc object
                const categoryName = category._doc.name || '';
                const lowerName = categoryName.toLowerCase();
                
                if (lowerName.includes('casual')) { 
              %>
                Casual<br>Wear
              <% } else if (lowerName.includes('office')) { %>
                Office<br>Wear
              <% } else if (lowerName.includes('festive')) { %>
                Festive<br>Wear
              <% } else { %>
                <%= categoryName || 'Category' %>
              <% } %>
            </h3>
            <a href="/shop?category=<%= category._id %>" class="category-link">
              Explore <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-gem"></i>
        <h3>No categories available</h3>
        <p>Check back soon for new collections</p>
      </div>
    <% } %>
  </div>
</section>
<!-- NEW ARRIVALS -->
<section class="section new-arrivals-section">
  <div class="section-header">
    <h2>New Arrivals</h2>
    <p>Discover our latest jewelry collections</p>
  </div>
  <div class="new-arrivals-grid">
    <% if (products && products.length > 0) { %>
      <% products.forEach(product => { %>
        <% 
          const variant = product.variants.find(v => v.isListed) || null; 
        %>
        <div class="product-card">
          <div class="product-image-container">
            <% if (variant && variant.images && variant.images.length > 0) { %>
              <img src="<%= variant.images[0] %>" alt="<%= product.name %>">
            <% } else { %>
              <img src="/images/placeholder.jpg" alt="No image available">
            <% } %>
            <div class="product-actions">
              <button class="wishlist-btn"><i class="far fa-heart"></i></button>
              <button class="quick-view-btn">Quick View</button>
            </div>
            <% if (!variant || variant.stock === 0) { %>
              <span class="out-of-stock">Out of Stock</span>
            <% } %>
          </div>
          <div class="product-info">
            <h3><%= product.name %></h3>
            <% if (variant) { %>
              <div class="price-container">
                <p class="product-price">₹<%= variant.discountedPrice || variant.price %></p>
                <% if (variant.discountedPrice && variant.discountedPrice < variant.price) { %>
                  <p class="original-price">₹<%= variant.price %></p>
                <% } %>
              </div>
              <p class="product-color">Color: <%= variant.color %></p>
            <% } else { %>
              <p class="product-price">Not available</p>
            <% } %>
            <button class="add-to-cart-btn">Add to Cart</button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-box-open"></i>
        <h3>No new arrivals</h3>
        <p>Check back soon for our latest collections</p>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/user/footer') %>
<script>
  // Mobile menu toggle
  document.querySelector('.mobile-menu-toggle').addEventListener('click', function() {
    document.querySelector('.nav-links').classList.toggle('active');
  });
</script>

</body>
</html>