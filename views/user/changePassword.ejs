<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Change Password</title>

<!-- Toastify CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<!-- Axios -->
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<!-- Toastify -->
<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

<style>
body {
  margin: 0;
  font-family: Poppins, Arial, sans-serif;
  background: black;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #fff;
}

.container {
  display: flex;
  background: #fff;
  color: #333;
  border-radius: 12px;
  overflow: hidden;
  width: 700px;
  max-width: 95%;
}

.logo-section {
  flex: 1;
  background: #f8f8f8;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.logo-section img {
  width: 80%;
  max-width: 220px;
}

.form-section {
  flex: 1;
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
}

.form-section h2 {
  text-align: center;
  margin-bottom: 20px;
  color: #1a3c6e;
  letter-spacing: 0.5px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

input {
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 14px;
  transition: border 0.2s ease;
}

input:focus {
  border-color: #1a3c6e;
  outline: none;
}

button {
  background: #1a3c6e;
  color: #fff;
  border: none;
  padding: 12px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 15px;
  transition: background 0.3s ease;
}

button:hover {
  background: #152e54;
}

.note {
  text-align: center;
  font-size: 13px;
  margin-top: 10px;
  color: #666;
}

a {
  color: #1a3c6e;
  text-decoration: none;
  font-size: 13px;
  text-align: right;
  display: block;
}

@media(max-width: 650px) {
  .container {
    flex-direction: column;
    width: 90%;
  }
  .logo-section {
    display: none;
  }
  .form-section {
    padding: 30px 20px;
  }
}
</style>

</head>
<body>

<div class="container">
  <div class="logo-section">
    <img src="/images/logo.png" alt="Logo">
  </div>

  <div class="form-section">
    <h2>Change Password</h2>

    <form id="changePasswordForm">
      <% if (!isForgotFlow) { %>
        <input type="password" id="oldPassword" placeholder="Old Password"/>
      <% } else { %>
        <input type="text" id="otp" placeholder="Enter OTP"/>
      <% } %>

      <input type="password" id="newPassword" placeholder="New Password"/>
      <input type="password" id="confirmPassword" placeholder="Confirm New Password"/>

      <input type="hidden" id="email" value="<%= userEmail %>">
      <input type="hidden" id="isForgotFlow" value="<%= isForgotFlow %>">

      <button type="submit">Change Password</button>
    </form>

    <% if (!isForgotFlow) { %>
      <div class="note">
        <a href="/user/forgotChangePassword">Forgot Password?</a>
      </div>
    <% } %>
  </div>
</div>

<script>
document.getElementById("changePasswordForm").addEventListener("submit", async (e) => {
  e.preventDefault();

  const oldPassword = document.getElementById("oldPassword")?.value;
  const otp = document.getElementById("otp")?.value;
  const newPassword = document.getElementById("newPassword").value;
  const confirmPassword = document.getElementById("confirmPassword").value;
  const email = document.getElementById("email").value;
  const isForgotFlow = document.getElementById("isForgotFlow").value === "true";

  if (!newPassword || !confirmPassword) {
    return Toastify({ 
      text: "Please fill all fields", 
    backgroundColor: "red", 
    duration: 3000 }).showToast();
  }
  if (!isForgotFlow && !oldPassword) {
    return Toastify({ text: "Old password is required", backgroundColor: "red", duration: 3000 }).showToast();
  }
  if (isForgotFlow && !otp) {
    return Toastify({ text: "OTP is required", backgroundColor: "red", duration: 3000 }).showToast();
  }
  if (newPassword.length < 6) {
    return Toastify({ text: "Password must be at least 6 characters", backgroundColor: "orange", duration: 3000 }).showToast();
  }
  if (newPassword !== confirmPassword) {
    return Toastify({ text: "Passwords do not match", backgroundColor: "red", duration: 3000 }).showToast();
  }

  try {
    const endpoint = isForgotFlow ? "/user/resetPassword" :"/user/changePassword";
   const payload = isForgotFlow
  ? { email, otp, newPassword, confirmPassword, isForgotFlow }
  : { email, oldPassword, newPassword, confirmPassword, isForgotFlow };

    const res = await axios.post(endpoint, payload);

    Toastify({
      text: res.data.message,
      backgroundColor: res.data.success ? "green" : "red",
      duration: 3000
    }).showToast();

    if (res.data.success) {
      setTimeout(() => window.location.href = "/user/login", 1500);
    }
  } catch (err) {
    Toastify({ text: "Server error", backgroundColor: "red", duration: 3000 }).showToast();
  }
});
</script>

</body>
</html>
