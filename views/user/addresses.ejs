<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>

  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

  <link rel="stylesheet" href="/styles/user/common.css">
  <link rel="stylesheet" href="/styles/user/sidebar.css">
  <link rel="stylesheet" href="/styles/user/<%= pagecss %>">
</head>

<body>
  <%- include('../partials/user/navbar') %>

  <div class="profile-wrapper">
    <%- include('../partials/user/sidebar', { user, activePage: 'addresses' }) %>

    <div class="address-container">
      <h1>My Addresses</h1>

      <!-- Add Address Button -->
      <div class="add-address-header">
        <button class="add-address-btn" onclick="openAddModal()">
          <i class="fas fa-plus"></i>
          Add New Address
        </button>
      </div>

      <!-- Saved Addresses -->
      <div class="section-header">
        <h2>Saved Addresses</h2>
        <span class="address-count"><%= addresses.length %> address<%= addresses.length !== 1 ? 'es' : '' %></span>
      </div>
      
      <div class="address-list">
        <% if (!addresses || addresses.length === 0) { %>
          <div class="empty-state">
            <i class="fas fa-map-marker-alt"></i>
            <p>No addresses saved yet.</p>
            <p class="empty-subtext">Add your first address to get started</p>
          </div>
        <% } else { %>
          <% addresses.forEach(addr => { %>
            <div class="address-card <%= addr.isDefault ? 'default-address' : '' %>">
              <div class="address-header">
                <div class="address-type-badge"><%= addr.addressType %></div>
                <% if (addr.isDefault) { %>
                  <div class="default-indicator">
                    <i class="fas fa-star"></i>
                    Default Address
                  </div>
                <% } %>
              </div>
              
              <div class="address-content">
                <p class="address-name-phone">
                  <strong><%= addr.name %></strong> • <%= addr.phone %>
                </p>
                <p class="address-line"><%= addr.houseName %>, <%= addr.locality %></p>
                <p class="address-line"><%= addr.city %>, <%= addr.state %> - <%= addr.pincode %></p>
                <p class="address-line"><%= addr.country %></p>
                <% if (addr.landmark) { %>
                  <p class="address-landmark">
                    <i class="fas fa-map-marker-alt"></i>
                    Landmark: <%= addr.landmark %>
                  </p>
                <% } %>
              </div>
              
              <div class="address-footer">
                <div class="address-actions">
                  <% if (!addr.isDefault) { %>
                    <button class="set-default-btn" onclick="setAsDefault('<%= addr._id %>')">
                      <i class="fas fa-star"></i>
                      Set as Default
                    </button>
                  <% } %>
                  
                  <button class="edit-btn" onclick="openEditModal('<%= addr._id %>')">
                    <i class="fas fa-edit"></i>
                    Edit
                  </button>
                  
                 <button class="delete-btn" onclick="openDeleteModal('<%= addr._id %>')">
                  <i class="fas fa-trash"></i>
                  Delete
                </button>

                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Add Address Modal -->
  <div id="addAddressModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>
          <i class="fas fa-plus-circle"></i>
          Add New Address
        </h2>
        <button class="close-btn" onclick="closeAddModal()">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form class="address-form" id="addAddressForm">
        <div class="form-grid">
          <div class="form-group">
            <label for="name" class="form-label">
              <i class="fas fa-user"></i>
              Full Name *
            </label>
            <input type="text" id="name" name="name" placeholder="Enter your full name" >
            <span class="error-message" id="nameError"></span>
          </div>

          <div class="form-group">
            <label for="phone" class="form-label">
              <i class="fas fa-phone"></i>
              Phone Number *
            </label>
            <input type="tel" id="phone" name="phone" placeholder="10-digit phone number" maxlength="10" pattern="[6-9][0-9]{9}" >
            <span class="error-message" id="phoneError"></span>
          </div>

          <div class="form-group full-width">
            <label for="houseName" class="form-label">
              <i class="fas fa-home"></i>
              House / Building *
            </label>
            <input type="text" id="houseName" name="houseName" placeholder="House no. and building name" >
            <span class="error-message" id="houseNameError"></span>
          </div>

          <div class="form-group full-width">
            <label for="locality" class="form-label">
              <i class="fas fa-map-pin"></i>
              Locality / Area *
            </label>
            <input type="text" id="locality" name="locality" placeholder="Area, Street, Locality" >
            <span class="error-message" id="localityError"></span>
          </div>

          <div class="form-group">
            <label for="pincode" class="form-label">
              <i class="fas fa-map-marked-alt"></i>
              Pincode *
            </label>
            <div class="pincode-wrapper">
              <input type="text" id="pincode" name="pincode" maxlength="6" placeholder="6-digit pincode" pattern="[1-9][0-9]{5}" >
              <div id="spinner" class="spinner"></div>
            </div>
            <span class="error-message" id="pincodeError"></span>
          </div>

          <div class="form-group">
            <label for="city" class="form-label">
              <i class="fas fa-city"></i>
              City *
            </label>
            <input type="text" id="city" name="city" placeholder="City" >
            <span class="error-message" id="cityError"></span>
          </div>

          <div class="form-group">
            <label for="state" class="form-label">
              <i class="fas fa-landmark"></i>
              State *
            </label>
            <input type="text" id="state" name="state" placeholder="State" readonly >
            <span class="error-message" id="stateError"></span>
          </div>

          <div class="form-group">
            <label for="country" class="form-label">
              <i class="fas fa-globe"></i>
              Country *
            </label>
            <input type="text" id="country" name="country" placeholder="Country" readonly >
          </div>

          <div class="form-group full-width">
            <label for="landmark" class="form-label">
              <i class="fas fa-map-marker-alt"></i>
              Landmark (Optional)
            </label>
            <input type="text" id="landmark" name="landmark" placeholder="Nearby landmark for easy identification">
          </div>

          <div class="form-group">
            <label for="addressType" class="form-label">
              <i class="fas fa-tag"></i>
              Address Type *
            </label>
            <select name="addressType" id="addressType" >
              <option value="" disabled selected>Select type</option>
              <option value="Home">🏠 Home</option>
              <option value="Work">💼 Work</option>
              <option value="Other">📦 Other</option>
            </select>
            <span class="error-message" id="addressTypeError"></span>
          </div>

          <div class="form-group checkbox-group full-width">
            <label class="checkbox-label">
              <input type="checkbox" id="isDefault" name="isDefault" value="true">
              <span class="checkmark"></span>
              Set as default address
            </label>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeAddModal()">
            <i class="fas fa-times"></i>
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i>
            Save Address
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Address Modal -->
  <div id="editAddressModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>
          <i class="fas fa-edit"></i>
          Edit Address
        </h2>
        <button class="close-btn" onclick="closeEditModal()">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form class="address-form" id="editAddressForm">
        <input type="hidden" id="editAddressId">
        
        <div class="form-grid">
          <div class="form-group">
            <label for="editName" class="form-label">
              <i class="fas fa-user"></i>
              Full Name *
            </label>
            <input type="text" id="editName" name="name" >
            <span class="error-message" id="nameEditError"></span>
          </div>

          <div class="form-group">
            <label for="editPhone" class="form-label">
              <i class="fas fa-phone"></i>
              Phone Number *
            </label>
            <input type="tel" id="editPhone" name="phone" maxlength="10" pattern="[6-9][0-9]{9}" >
            <span class="error-message" id="phoneEditError"></span>
          </div>

          <div class="form-group full-width">
            <label for="editHouse" class="form-label">
              <i class="fas fa-home"></i>
              House / Building *
            </label>
            <input type="text" id="editHouse" name="houseName" >
            <span class="error-message" id="houseNameEditError"></span>
          </div>

          <div class="form-group full-width">
            <label for="editLocality" class="form-label">
              <i class="fas fa-map-pin"></i>
              Locality / Area *
            </label>
            <input type="text" id="editLocality" name="locality" >
            <span class="error-message" id="localityEditError"></span>
          </div>

          <div class="form-group">
            <label for="editPincode" class="form-label">
              <i class="fas fa-map-marked-alt"></i>
              Pincode *
            </label>
            <div class="pincode-wrapper">
              <input type="text" id="editPincode" name="pincode" maxlength="6" pattern="[1-9][0-9]{5}" >
              <div id="editSpinner" class="spinner"></div>
            </div>
            <span class="error-message" id="pincodeEditError"></span>
          </div>

          <div class="form-group">
            <label for="editCity" class="form-label">
              <i class="fas fa-city"></i>
              City *
            </label>
            <input type="text" id="editCity" name="city" >
            <span class="error-message" id="cityEditError"></span>
          </div>

          <div class="form-group">
            <label for="editState" class="form-label">
              <i class="fas fa-landmark"></i>
              State *
            </label>
            <input type="text" id="editState" name="state" readonly >
            <span class="error-message" id="stateEditError"></span>
          </div>

          <div class="form-group">
            <label for="editCountry" class="form-label">
              <i class="fas fa-globe"></i>
              Country *
            </label>
            <input type="text" id="editCountry" name="country" readonly >
          </div>

          <div class="form-group full-width">
            <label for="editLandmark" class="form-label">
              <i class="fas fa-map-marker-alt"></i>
              Landmark (Optional)
            </label>
            <input type="text" id="editLandmark" name="landmark">
          </div>

          <div class="form-group">
            <label for="editType" class="form-label">
              <i class="fas fa-tag"></i>
              Address Type *
            </label>
            <select id="editType" name="addressType" >
              <option value="Home">🏠 Home</option>
              <option value="Work">💼 Work</option>
              <option value="Other">📦 Other</option>
            </select>
            <span class="error-message" id="addressTypeEditError"></span>
          </div>

          <div class="form-group checkbox-group full-width">
            <label class="checkbox-label">
              <input type="checkbox" id="editIsDefault" name="isDefault" value="true">
              <span class="checkmark"></span>
              Set as default address
            </label>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeEditModal()">
            <i class="fas fa-times"></i>
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i>
            Update Address
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="modal">
    <div class="modal-content confirmation-modal">
      <div class="confirmation-icon">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <h3>Delete Address</h3>
      <p>Are you sure you want to delete this address? This action cannot be undone.</p>
      <div class="confirmation-actions">
        <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">
          <i class="fas fa-times"></i>
          Cancel
        </button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
          <i class="fas fa-trash"></i>
          Delete
        </button>
      </div>
    </div>
  </div>

  <%- include('../partials/user/alert', { message, messageType }) %>
  <%- include('../partials/user/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
   <script src="/js/pincodeAutofill.js"></script>
  <script src="/js/address.js"></script>
</body>
</html>