<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <link rel="stylesheet" href="/styles/user/common.css">
  <link rel="stylesheet" href="/styles/user/<%= pagecss %>">
</head>
<body>
    <%- include('../partials/user/navbar') %>

    <!-- Cart Section -->
    <section class="section cart-section">
        <div class="section-header">
            <h2>Your Shopping Cart</h2>
            <p>Review your items and proceed to checkout</p>
        </div>

        <div class="cart-container">
            <% if (cart && cart.items && cart.items.length > 0) { %>
                <div class="cart-content">
                    <div class="cart-items">
                        <div class="cart-header">
                            <div class="header-product">Product</div>
                            <div class="header-price">Price</div>
                            <div class="header-quantity">Quantity</div>
                            <div class="header-total">Total</div>
                            <div class="header-actions"></div>
                        </div>
                        
                        <div class="cart-items-list">
  <% cart.items.forEach(function(item, index) { 
       // ✅ Safety check — skip null or broken items
       if (!item.productId || !item.productVariantId) return; 
  %>
    <div class="cart-item" 
         data-id="<%= item._id %>" 
         data-product-id="<%= item.productId._id %>" 
         data-variant-id="<%= item.productVariantId._id %>">
         
      <div class="item-product">
        <div class="product-image">
          <% if (item.productVariantId.images && item.productVariantId.images.length > 0) { %>
            <img src="<%= item.productVariantId.images[0] %>" alt="<%= item.productId.name %>">
          <% } else { %>
            <img src="/images/placeholder.jpg" alt="No image available">
          <% } %>
        </div>

                                        <div class="product-details">
                                            <h3 class="product-name"><%= item.productId.name %></h3>
                                            <p class="product-color">
                                              Color: <span class="color-value"><%= item.productVariantId.color %></span>
                                            </p>

                                            <% if (item.productVariantId.stock > 0) { %>
                                              <p class="product-stock">
                                                <span class="in-stock">In Stock <%= item.productVariantId.stock %></span>
                                              </p>
                                            <% } else { %>
                                              <p class="product-stock">
                                                <span class="out-of-stock">Out of Stock</span>
                                              </p>
                                              <p class="stock-warning">
                                             Please remove it before checkout.
                                              </p>
                                            <% } %>
                                          </div>

                                    </div>
                                    
                                    <div class="item-price">
                                 <% if (item.discountedPriceAtTime && item.discountedPriceAtTime < item.priceAtTime) { %>
                              <div class="discounted-price">₹<%= item.discountedPriceAtTime.toFixed(2) %></div>
                              <div class="original-price">₹<%= item.priceAtTime.toFixed(2) %></div>
                                        <% } else { %>
                                    <div class="current-price">₹<%= item.priceAtTime.toFixed(2) %></div>
                                        <% } %>
                                    </div>
                                  <div class="item-quantity">
  <div class="quantity-controls">

    <!-- Minus -->
    <button class="quantity-btn minus"
      data-product-id="<%= item.productId._id || item.productId %>"
      data-variant-id="<%= item.productVariantId._id || item.productVariantId %>">
      <i class="fas fa-minus"></i>
    </button>

    <!-- Number input -->
    <input type="number" class="quantity-input"
      value="<%= item.quantity %>"
      min="1"
      max="10"
      data-product-id="<%= item.productId._id || item.productId %>"
      data-variant-id="<%= item.productVariantId._id || item.productVariantId %>"
      data-stock="<%= item.productVariantId.stock %>">

    <!-- Plus -->
    <button class="quantity-btn plus"
      data-product-id="<%= item.productId._id || item.productId %>"
      data-variant-id="<%= item.productVariantId._id || item.productVariantId %>">
      <i class="fas fa-plus"></i>
    </button>

  </div>

 
</div>

                                    
                                    <div class="item-total">
                                        <% 
                                            let itemTotal = item.discountedPriceAtTime && item.discountedPriceAtTime < item.priceAtTime 
                                                ? item.discountedPriceAtTime * item.quantity 
                                                : item.priceAtTime * item.quantity;
                                        %>
                                    ₹<%= itemTotal.toFixed(2) %>
                                    </div>
                                    
                                    <div class="item-actions">
                                        <button class="remove-btn" data-id="<%= item._id %>" data-product-id="<%= item.productId._id %>" data-variant-id="<%= item.productVariantId._id %>">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                    
                                 <%
  const availableItems = cart.items.filter(item => item.productVariantId.stock > 0);
  const outOfStockItems = cart.items.filter(item => item.productVariantId.stock <= 0);
    const allOutOfStock = availableItems.length === 0; // ✅ Add this line

%>

                                                 <div class="cart-summary">
                        <div class="summary-card">
                            <h3>Price Details</h3>
                            
                            <div class="summary-row">
                                <span>Subtotal (<%= cart.items.reduce((total, item) => total + item.quantity, 0) %> items)</span>
                                  <span class="subtotal">₹<%= subtotal.toFixed(2) %></span>
                            </div>
                            
                           <div class="summary-row">
                              <span>Shipping</span>
                              <span class="shipping">
                                <% if (subtotal > 50) { %>
                                  FREE
                                <% } else { %>
                                  ₹5.00
                                <% } %>
                              </span>
                            </div>

                            
                            <div class="summary-row">
                                <span>Tax</span>
                                      <span class="tax">₹<%= tax.toFixed(2) %></span>
                            </div>
                            
                            <% if (totalSavings > 0) { %>
                                <div class="summary-row savings">
                                    <span>You Save</span>
                                    <span class="savings-amount">-₹<%= totalSavings.toFixed(2) %></span>
                                </div>
                            <% } %>
                            
                            <div class="summary-divider"></div>
                            
                            <div class="summary-row total">
                                <span>Total</span>
                        <span class="total-amount">₹<%= total.toFixed(2) %></span>
                            </div>
                            
                  
                                        <% if (outOfStockItems.length > 0) { %>
                                            <p class="warning-text" style="color: brown;">
                                              Some items are out of stock and will not be included in your checkout.
                                            </p>
                                          <% } %>
                                                                
                                                                      
                                      <button 
                                        class="checkout-btn" 
                                        id="proceed-checkout"
                                        <%= allOutOfStock ? 'disabled title="All items are out of stock, remove them to proceed"' : '' %>>
                                        Proceed to Checkout
                                      </button>

                                                              
                            <div class="continue-shopping">
                                <a href="/user/shop" >
                                    <i class="fas fa-arrow-left"></i>
                                    Continue Shopping
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="empty-cart">
                    <div class="empty-state">
                        <i class="fas fa-shopping-cart"></i>
                        <h3>Your cart is empty</h3>
                        <p>Looks like you haven't added any items to your cart yet.</p>
                        <a href="/user/shop" class="shop-now-btn">Start Shopping</a>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loading-overlay">
        <div class="loading-spinner"></div>
        <p>Updating cart...</p>
    </div>

    <!-- Success Message -->
    <div class="message-toast success" id="success-toast">
        <i class="fas fa-check-circle"></i>
        <span id="success-message"></span>
    </div>

    <!-- Error Message -->
    <div class="message-toast error" id="error-toast">
        <i class="fas fa-exclamation-circle"></i>
        <span id="error-message"></span>
    </div>


    <!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal">
  <div class="modal-content confirmation-modal">
    <div class="confirmation-icon">
      <i class="fas fa-exclamation-triangle"></i>
    </div>
    <h3>Remove Item</h3>
    <p>Are you sure you want to remove this item from your cart?</p>
    <div class="confirmation-actions">
      <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">
        <i class="fas fa-times"></i>
        Cancel
      </button>
      <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
        <i class="fas fa-trash"></i>
        Remove
      </button>
    </div>
  </div>
</div>

  <%- include('../partials/user/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/incrementDecrementCart.js"></script>
</body>
</html>