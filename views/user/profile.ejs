<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile</title>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/user/common.css">
  <link rel="stylesheet" href="/styles/user/<%= pagecss %>">
    <link rel="stylesheet" href="/styles/user/sidebar.css">


  <link rel="stylesheet" type="text/css"
  href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css"> 

</head>
<body>
  <%- include('../partials/user/navbar') %>
<div class="profile-container">

  <div class="profile-header">
    <h1>User Profile</h1>
    <a href="/user/editProfile" class="edit-btn">Edit Profile</a>
  </div>

  <!-- MAIN WRAPPER FOR SIDEBAR + CONTENT -->
  <div class="profile-wrapper">

      <!-- SIDEBAR (loaded from partial) -->
      <%- include('../partials/user/sidebar', { user, activePage: 'profile' }) %>

      <!-- RIGHT SIDE CONTENT -->
      <div class="profile-main">

          <div class="profile-image-top">
            <img 
              src="<%= user.profileImage %>"
              alt="Profile Image"
              onerror="this.onerror=null; this.src='https://res.cloudinary.com/dqcd6e4ux/image/upload/v1761935135/free-user-icon-3296-thumb_rsdnow.png';"
            />
          </div>

          <section id="details" class="profile-section active">
            <h2>Personal Details</h2>

            <div class="details-grid">
              <div class="detail-item">
                <label>Full Name</label>
                <p><%= user.name %></p>
              </div>

              <div class="detail-item">
                <label>Email</label>
                <p><%= user.email %></p>
              </div>

              <div class="detail-item">
                <label>Phone</label>
                <p><%= user.phone || 'Not provided' %></p>
              </div>
            </div>
          </section>

      </div> 

  </div> 

</div>


  <!-- <script src="/js/profile.js"></script> -->
     <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script src="/js/orders.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <%- include('../partials/user/footer') %>
</body>
</html>
