<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle || "Shop All Jewelry" %></title>
  <link rel="stylesheet" href="/styles/user/common.css">
<link rel="stylesheet" href="/styles/user/<%= pagecss %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>

  <%- include('../partials/user/navbar') %>

  <!-- Shop Header -->
  <section class="shop-header">
    <div class="container">
      <h1>
        <% if (categoryName) { %>
          Shop <%= categoryName %>
        <% } else { %>
          Shop All Jewelry
        <% } %>
      </h1>
      <p class="subtitle">
        <% if (categoryName) { %>
          Discover our curated collection of <%= categoryName.toLowerCase() %> pieces
        <% } else { %>
          Discover our curated collection of timeless pieces
        <% } %>
      </p>
    
    </div>
  </section>

  <!-- Main Content -->
  <main class="shop-main">
    <div class="container">
      <div class="shop-layout">
        
        <!-- Sidebar Filters -->
        <aside class="filters-sidebar">
          <div class="filter-header">
            <h3>Filters</h3>
            <% if (search || category || minPrice || maxPrice || sort !== 'latest') { %>
              <a href="/user/shop" class="clear-all">Clear All</a>
            <% } %>
          </div>

          <form method="GET" action="/user/shop" class="filter-form">
            <!-- Search -->
            <div class="filter-group">
              <label for="search">Search</label>
              <input type="text" id="search" name="search" placeholder="Search products..." value="<%= search %>">
            </div>

            <!-- Category Filter -->
            <div class="filter-group">
              <label for="category">Category</label>
              <select id="category" name="category">
                <option value="">All Categories</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat._id %>" <%= cat._id.toString() == category ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Price Range -->
            <div class="filter-group">
              <label>Price Range</label>
              <div class="price-inputs">
                <input type="number" name="minPrice" placeholder="Min" value="<%= minPrice %>">
                <span class="price-separator">-</span>
                <input type="number" name="maxPrice" placeholder="Max" value="<%= maxPrice %>">
              </div>
            </div>

            <!-- Sorting -->
            <div class="filter-group">
              <label for="sort">Sort By</label>
              <select id="sort" name="sort">
                <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Latest</option>
                <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="a-z" <%= sort === 'a-z' ? 'selected' : '' %>>A - Z</option>
                <option value="z-a" <%= sort === 'z-a' ? 'selected' : '' %>>Z - A</option>
              </select>
            </div>

            <button type="submit" class="apply-filters-btn">
              <i class="fas fa-filter"></i> Apply Filters
            </button>
          </form>
        </aside>

        <!-- Product Listing -->
        <section class="products-section">
          <div class="products-header">
            <p class="results-count">
              <% if (products.length > 0) { %>
                <% if (categoryName) { %>
                  Showing <%= products.length %> <%= categoryName.toLowerCase() %> product<%= products.length !== 1 ? 's' : '' %>
                <% } else { %>
                  Showing <%= products.length %> product<%= products.length !== 1 ? 's' : '' %>
                <% } %>
              <% } %>
            </p>
          </div>

          <% if (products.length > 0) { %>
       <div class="product-grid">
  <% products.forEach(product => {
      let displayVariant = null;
      let isOutOfStock = true; // default assume out of stock

      if (product.variants && product.variants.length > 0) {
          // Find first variant that is listed and has stock
          displayVariant = product.variants.find(v => v.isListed && v.stock > 0);

          if (displayVariant) {
              isOutOfStock = false; // found a variant with stock
          } else {
              // fallback to first variant even if stock 0
              displayVariant = product.variants[0];
          }
      }

      // Check for discount
      const hasDiscount = displayVariant && displayVariant.discountedPrice && displayVariant.discountedPrice < displayVariant.price;
  %>

  <div class="product-card">
    <div class="product-image-container">
      <a href="/user/product/<%= product._id %>" class="product-image-link">
        <% if (displayVariant && displayVariant.images.length > 0) { %>
          <img src="<%= displayVariant.images[0] %>" alt="<%= product.name %>">
        <% } else { %>
          <img src="/images/placeholder.jpg" alt="No image">
        <% } %>
      </a>

      <div class="product-actions">
        <button class="wishlist-btn" title="Add to Wishlist">
          <i class="far fa-heart"></i>
        </button>
      </div>
<%
  let badgeLabel = "";
  let badgeClass = "";

  const categoryIsUnlisted =
    product.category &&
    typeof product.category === "object" &&
    product.category.isListed === false;

  if (categoryIsUnlisted) {
    badgeLabel = "Unavailable";
    badgeClass = "unavailable-badge";
  } else if (!displayVariant || !displayVariant.isListed) {
    badgeLabel = "Unavailable";
    badgeClass = "unavailable-badge";
  } else if (isOutOfStock) {
    badgeLabel = "Out of Stock";
    badgeClass = "out-of-stock-badge";
  } else if (displayVariant.stock <= 5) {
    badgeLabel = "Limited Stock";
    badgeClass = "limited-stock-badge";
  } else if (hasDiscount) {
    badgeLabel = "Sale";
    badgeClass = "discount-badge";
  }
%>

<% if (badgeLabel) { %>
  <span class="product-badge <%= badgeClass %>"><%= badgeLabel %></span>
<% } %>

    </div>
<div class="product-info">
  <a href="/user/product/<%= product._id %>" class="product-name-link">
    <h3 class="product-name"><%= product.name %></h3>
  </a>

  <% if (displayVariant) { %>
    <div class="price-container">
      <% if (hasDiscount) { %>
        <span class="current-price">₹<%= displayVariant.discountedPrice %></span>
        <span class="original-price">₹<%= displayVariant.price %></span>
      <% } else { %>
        <span class="current-price">₹<%= displayVariant.price %></span>
      <% } %>
    </div>
  <% } else { %>
    <p class="not-available">Not available</p>
  <% } %>

  <!-- Action Buttons (Wishlist + Quick View) -->
  <div class="product-actions">
   <button 
  class="wishlist-btn"
  data-product-id="<%= product._id %>" 
  data-variant-id="<%= displayVariant ? displayVariant._id : '' %>"
  title="Add to Wishlist">
  <i class="far fa-heart"></i>
</button>

    <button class="quick-view-btn" 
            title="Quick View"
            onclick="window.location.href='/user/product/<%= product._id %>'">
      <i class="fas fa-eye"></i>
    </button>
  </div>
</div>

  </div>

  <% }) %>
</div>


            <!-- Pagination -->
            <% if (totalPages > 1) { %>
              <div class="pagination">
                <% if (currentPage > 1) { %>
                  <a href="/user/shop?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&sort=<%= sort %>" class="page-link prev">
                    <i class="fas fa-chevron-left"></i> Prev
                  </a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                  <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                    <a href="/user/shop?page=<%= i %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&sort=<%= sort %>"
                       class="page-link <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                  <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                    <span class="page-dots">...</span>
                  <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                  <a href="/user/shop?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&sort=<%= sort %>" class="page-link next">
                    Next <i class="fas fa-chevron-right"></i>
                  </a>
                <% } %>
              </div>
            <% } %>

          <% } else { %>
            <div class="empty-state">
              <div class="empty-icon">
                <i class="fas fa-box-open"></i>
              </div>
              <% if (categoryName) { %>
                <h3>No <%= categoryName.toLowerCase() %> products found</h3>
                <p>We couldn't find any <%= categoryName.toLowerCase() %> products matching your criteria.</p>
              <% } else { %>
                <h3>No products found</h3>
                <% if (search) { %>
                  <p>No results for "<%= search %>". Try a different keyword.</p>
                <% } else { %>
                  <p>We couldn't find any products matching your criteria.</p>
                <% } %>
              <% } %>
              <a href="/user/shop" class="browse-btn">Browse All Products</a>
            </div>
          <% } %>
        </section>
      </div>
    </div>
  </main>

  <%- include('../partials/user/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Wishlist toggle
      document.querySelectorAll('.wishlist-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          this.classList.toggle('active');
          this.querySelector('i').classList.toggle('far');
          this.querySelector('i').classList.toggle('fas');
        });
      });
    });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
          <script src="/js/wishlist.js"></script>



</body>
</html>