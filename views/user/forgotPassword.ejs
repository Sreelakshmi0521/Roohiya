<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: black;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            position: relative
        }
        .container {
            position: relative;
            display: flex;
            background-color: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
             z-index: 1;
        }
        .logo-section {
            width: 300px;
            display: flex;
              justify-content: center;
            align-items: center;
        }
        .logo-section img {
            width: 250px;
        }
        .form-section {
            padding: 40px;
            width: 300px;
            text-align: center;
        }
        .form-section h2 {
            margin-bottom: 20px;
            color: #333;
        }
        .form-section p {
            margin-bottom: 15px;
            color: #666;
        }
        .form-section input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .form-section button {
            width: 100%;
            padding: 10px;
            background-color: #1a3c6e;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .form-section button:hover {
            background-color: #152e54;
        }
        .form-section .footer-text {
            margin-top: 20px;
            font-size: 12px;
            color: #999;
        }
        .alert {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
            text-align: left;
        }
        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }
        .swal-custom {
            z-index: 1000 !important; /* Ensure modal is above everything */
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo-section">
            <img src="/images/logo.png" alt="Roohiya Logo">
        </div>
        <div class="form-section">
            <h2>Reset Password</h2>
            <% if (message) { %>
                <div class="alert <%= messageType === 'success' ? 'alert-success' : 'alert-warning' %>">
                    <p class="mb-0"><%= message %></p>
                </div>
            <% } %>
            <p>Please Confirm Your Email</p>
            <form id="resetForm">
                <input type="email" name="email" placeholder="Email Address" id="email">
                <button type="submit">Get OTP</button>
            </form>
            <p class="footer-text">Roohiya</p>
        </div>
    </div>
    
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/forgotPassword.js"></script> 
</body>
</html>