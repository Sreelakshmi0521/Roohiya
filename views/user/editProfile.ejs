<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="/styles/user/common.css">
  <link rel="stylesheet" href="/styles/user/<%= pagecss %>">

</head>
<body>
    
  <%- include('../partials/user/navbar') %>
    <div class="edit-profile-container">
        <div class="edit-profile-header">
            <h1>Edit Profile</h1>
            <a href="/user/profile" class="back-btn">Back to Profile</a>
        </div>

        <div class="edit-profile-content">
            <form id="editProfileForm" class="edit-profile-form" action="/user/editProfile" method="POST" enctype="multipart/form-data">
                <div class="form-section">
                    <h2>Profile Image</h2>
                    <div class="profile-image-edit">
                        <div class="current-image">
                            <img src="<%= user.profileImage || '/images/default-profile.png' %>" alt="Current Profile Image" id="currentProfileImg">
                        </div>
                        <div class="image-upload">
                            <label for="profileImage">Upload New Image</label>
                            <input type="file" id="profileImage" name="profileImage" accept="image/*">
                            <p class="file-info">Supported formats: JPG, PNG, GIF. Max size: 2MB</p>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h2>Personal Information</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="name">Full Name *</label>
                            <input type="text" id="name" name="name" value="<%= user.name %>">
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address *</label>
                           <input type="email" id="email" name="email" value="<%= user.email %>" <%= isGoogleUser ? 'readonly' : '' %>  <%= isGoogleUser ? 'class="disabled-input"' : '' %>>
                                <% if (isGoogleUser) { %>
                                <small style="color: gray;">Email cannot be changed for Google users.</small>
                                <% } %>
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>">
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-secondary" id="cancelBtn">Cancel</button>
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/editProfile.js"></script>
     <%- include('../partials/user/footer') %>
</body>
</html>