<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify New Email - OTP</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #000;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .container {
      display: flex;
      background-color: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }
    .logo-section {
      width: 280px;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #f7f7f7;
    }
    .logo-section img { width: 220px; }
    .form-section {
      width: 320px;
      padding: 40px;
      text-align: center;
    }
    .form-section h2 { margin-bottom: 10px; color: #333; }
    .form-section p { color: #555; font-size: 14px; }
    input {
      width: 100%;
      padding: 10px;
      margin-top: 15px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 14px;
    }
    button {
      width: 100%;
      margin-top: 15px;
      padding: 10px;
      background-color: #1a3c6e;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 15px;
    }
    button:hover { background-color: #152e54; }
    .timer { color: #888; margin-top: 8px; }
    .resend { margin-top: 10px; font-size: 13px; }
    .resend a { color: #1a3c6e; text-decoration: none; font-weight: bold; }
    .resend a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <div class="container">
    <div class="logo-section">
      <img src="/images/logo.png" alt="Roohiya Logo">
    </div>

    <div class="form-section">
      <h2>Email Verification</h2>
      <p>We sent an OTP to your new email:</p>
      <p><strong><%= email %></strong></p>

      <form id="verifyEmailOtpForm">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="text" name="otp" id="otp" placeholder="Enter OTP" >
        <p class="timer" id="timer">Remaining: 01:00</p>
        <button type="submit">Verify OTP</button>
      </form>

      <p class="resend">Didn't get it? <a href="#" id="resendOtp">Resend OTP</a></p>
      <p style="font-size: 12px; color: #aaa; margin-top: 20px;">Roohiya</p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

  <script>
document.addEventListener('DOMContentLoaded', () => {
    const timerElement = document.getElementById('timer');
    const verifyBtn = document.querySelector("#verifyEmailOtpForm button");
    const resendLink = document.getElementById("resendOtp");
    const otpForm = document.getElementById("verifyEmailOtpForm");

    let timeLeft = 60;
    let countdown;
    let otpVerified = false;

  
    function enableResend() {
        resendLink.style.pointerEvents = "auto";
        resendLink.style.opacity = 1;
    }

    function disableResend() {
        resendLink.style.pointerEvents = "none";
        resendLink.style.opacity = 0.5;
    }

   
    function startTimer() {
        clearInterval(countdown);
        timeLeft = 60;
        verifyBtn.disabled = false;
        disableResend();

        countdown = setInterval(() => {
            if (timeLeft <= 0) {
                clearInterval(countdown);
                timerElement.textContent = "OTP expired. You can resend now.";
                timerElement.style.color = "red";
                if (!otpVerified) enableResend();
            } else {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                timerElement.textContent = `Remaining: ${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
                timeLeft--;
            }
        }, 1000);
    }

    startTimer();

    
    otpForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (otpVerified) return;

        const otp = document.getElementById("otp").value.trim();
        const email = document.querySelector('input[name="email"]').value;

        if (!otp) {
            Toastify({ text: "Please enter the OTP!", duration: 3000, gravity: "top", position: "right", backgroundColor: "#FF0000" }).showToast();
            return;
        }

        if (!/^\d{6}$/.test(otp)) {
            Toastify({ text: "OTP must be 6 digits", duration: 3000, gravity: "top", position: "right", backgroundColor: "#FF0000" }).showToast();
            return;
        }

        try {
            const response = await axios.post("/user/verifyEmailOtp", { email, otp });
            if (response.data.success) {
                otpVerified = true;
                clearInterval(countdown);
                disableResend();
                Toastify({ text: "Email verified successfully!", duration: 3000, gravity: "top", position: "right", backgroundColor: "#4CAF50" }).showToast();
                setTimeout(() => { window.location.href = "/user/profile"; }, 1500);
            } else {
                Toastify({ text: response.data.message || "Invalid or expired OTP.", duration: 3000, gravity: "top", position: "right", backgroundColor: "#FF0000" }).showToast();
            }
        } catch (err) {
            Toastify({ text: "Server error. Try again later!", duration: 3000, gravity: "top", position: "right", backgroundColor: "#FF0000" }).showToast();
        }
    });

   
    resendLink.addEventListener("click", async (e) => {
        e.preventDefault();
        if (resendLink.style.pointerEvents === "none") return;

        disableResend();
        const email = document.querySelector('input[name="email"]').value;

        try {
            const response = await axios.post("/user/resendEmailOtp", { email });
            if (response.data.success) {
                Toastify({ text: "OTP resent successfully!", duration: 3000, gravity: "top", position: "right", backgroundColor: "#4CAF50" }).showToast();
                timeLeft = 60;
                startTimer();
            } else {
                Toastify({ text: response.data.message || "Failed to resend OTP.", duration: 3000, gravity: "top", position: "right", backgroundColor: "#FF0000" }).showToast();
                enableResend();
            }
        } catch (err) {
            Toastify({ text: "Server error while resending OTP!", duration: 3000, gravity: "top", position: "right", backgroundColor: "#FF0000" }).showToast();
            enableResend();
        }
    });
});
</script>


</body>
</html>
