<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reset Password</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: black;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        overflow: hidden;
        position: relative;
    }
    .container {
        position: relative;
        display: flex;
        background-color: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        z-index: 1;
    }
    .logo-section {
        width: 300px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .logo-section img {
        width: 250px;
    }
    .form-section {
        padding: 40px;
        width: 300px;
        text-align: center;
    }
    .form-section h2 {
        margin-bottom: 20px;
        color: #333;
    }
    .form-section input {
        width: 100%;
        padding: 10px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }
    .form-section button {
        width: 100%;
        padding: 10px;
        background-color: #1a3c6e;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }
    .form-section button:hover:not(:disabled) {
        background-color: #152e54;
    }
    .form-section button:disabled {
        background-color: #999;
        cursor: not-allowed;
    }
    .footer-text {
        margin-top: 20px;
        font-size: 12px;
        color: #999;
    }
    .otp-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        margin-bottom: 10px;
        color: red; 
    }
    .otp-footer button {
        font-size: 12px;
        padding: 3px 5px;
        width: auto;
    }
  </style>
</head>
<body>

<div class="container">
    <div class="logo-section">
        <img src="/images/logo.jpg" alt="Roohiya Logo">
    </div>
    <div class="form-section">
        <h2>Reset Password</h2>
        <form id="resetForm">
            <input type="hidden" id="email" value="<%= email %>">
            <input type="text" id="otp" placeholder="Enter OTP" >
            <div class="otp-footer">
                <span id="timer">03:00</span>
                <button type="button" id="resendOtpBtn" disabled>Resend OTP</button>
            </div>
            <input type="password" id="newPassword" placeholder="Enter new password" >
            <input type="password" id="confirmPassword" placeholder="Confirm new password" >
            <button type="submit" id="submitBtn">Submit</button>
        </form>
        <p class="footer-text">Roohiya</p>
    </div>
</div>


<script>
const submitBtn = document.getElementById("submitBtn");
const resendBtn = document.getElementById("resendOtpBtn");
const email = document.getElementById("email").value;
const timerSpan = document.getElementById("timer");
let otpTimer = 180;
let timerInterval;

function formatTime(sec){
  const m = String(Math.floor(sec/60)).padStart(2,'0');
  const s = String(sec%60).padStart(2,'0');
  return `${m}:${s}`;
}

function startTimer(){
  resendBtn.disabled = true;
  timerSpan.style.color = "red";
  timerSpan.textContent = formatTime(otpTimer);

  timerInterval = setInterval(()=>{
    otpTimer--;
    timerSpan.textContent = formatTime(otpTimer);
    if(otpTimer <= 0){
      clearInterval(timerInterval);
      timerSpan.textContent = "00:00";
      resendBtn.disabled = false;
      Toastify({text:"OTP expired, please resend", backgroundColor:"orange", duration:3000}).showToast();
    }
  },1000);
}

startTimer();

resendBtn.addEventListener("click", async ()=>{
  resendBtn.disabled = true;
  try{
    const res = await axios.post("/user/sendResetPasswordOtp", { email })

    Toastify({text: res.data.message, backgroundColor: res.data.success?"green":"red", duration:3000}).showToast()

    if(res.data.success){
      otpTimer = 180;
      clearInterval(timerInterval);
      startTimer();
    } else { resendBtn.disabled = false; }
  }catch(err){

    Toastify({text:"Server error", backgroundColor:"red", duration:3000}).showToast();
    resendBtn.disabled = false;
  }
});

document.getElementById("resetForm").addEventListener("submit", async (e)=>{
  e.preventDefault();
  submitBtn.disabled = true;

  const otp = document.getElementById("otp").value.trim();
  const newPassword = document.getElementById("newPassword").value.trim();
  const confirmPassword = document.getElementById("confirmPassword").value.trim();

  if(!otp || !newPassword || !confirmPassword){
    Toastify({text:"All fields required", backgroundColor:"red", duration:3000}).showToast();
    submitBtn.disabled = false;
    return
  }

  if(newPassword.length < 6){
    Toastify({text:"Password must be at least 6 characters", backgroundColor:"orange", duration:3000}).showToast();
    submitBtn.disabled = false;
    return;
  }

  if(newPassword !== confirmPassword){
    Toastify({text:"Passwords do not match", backgroundColor:"red", duration:3000}).showToast();
    submitBtn.disabled = false;
    return;
  }

  try{

    const res = await axios.post("/user/resetPassword", { email, otp, newPassword })

    Toastify({text: res.data.message, backgroundColor: res.data.success?"green":"red", duration:3000}).showToast()
    
    if(res.data.success){
      setTimeout(()=> window.location.href="/user/login", 1500);
    } else submitBtn.disabled=false;
  }catch(err){
    Toastify({text:"Server error", backgroundColor:"red", duration:3000}).showToast();
    submitBtn.disabled=false;
  }
});
</script>

</body>
</html>
