
<div class="add-product-form">
    <form id="productForm">
        <!-- Product Name -->
        <div class="form-group">
            <label for="productName">Product Name</label>
            <input type="text" id="productName" placeholder="Enter Product Name">
        </div>

        <!-- Category Dropdown -->
        <div class="form-group">
            <label for="category">Category</label>
            <select id="category" >
                <option value="">Select Category</option>
                <% if (typeof categories !== 'undefined') { %>
                    <% categories.forEach(function(cat) { %>
                        <% if (cat.isListed) { %>
                            <option value="<%= cat._id %>"><%= cat.name %></option>
                        <% } %>
                    <% }); %>
                <% } %>
            </select>
        </div>

        <!-- Highlights -->
        <div class="form-group">
            <label>Highlights</label>
            <div id="highlightsContainer">
                <input type="text" class="highlight-input" placeholder="Enter Highlights"> 
            </div>
        </div>

        <!-- Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" rows="4" placeholder="Write your description..."></textarea>
        </div>

        <!-- Add Variant Button -->
        <div class="form-group">
            <button type="button" id="addVariantBtn">Add Variant</button>
        </div>

        <!-- Variants List -->
        <div id="variantsContainer">
            <!-- Dynamically added variants will appear here -->
        </div>

        <div class="form-actions">
            <button type="button" class="cancel-btn">Cancel</button>
            <button type="submit" class="save-btn">Save</button>
        </div>
    </form>
</div>

<!-- Variant Modal (inline) -->
<div class="modal" id="variantModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add Variant</h3>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <form id="variantForm">
                <div class="form-group">
                    <label for="color">Color</label>
                    <input type="text" id="color">
                </div>
                <div class="form-group">
                    <label for="price">Price</label>
                    <input type="number" id="price" step="0.01" >
                </div>
                <div class="form-group">
                    <label for="discountPrice">Discount Price</label>
                    <input type="number" id="discountPrice" step="0.01">
                </div>
                <div class="form-group">
                    <label for="stockLimit">Stock Limit</label>
                    <input type="number" id="stockLimit" >
                </div>
                <div class="form-group">
                    <label>Images (Upload 3)</label>
                    <div class="image-uploads">
                        <input type="file" id="image1" accept="image/*" >
                        <input type="file" id="image2" accept="image/*" >
                        <input type="file" id="image3" accept="image/*" >
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="cancel-btn" id="closeModalBtn">Close</button>
            <button type="button" class="save-btn" id="saveVariantBtn">Save Variant</button>
        </div>
    </div>
</div>
