
        <main class="main-content">
            <div class="page-header">
                <h1>Add New Product</h1>
            </div>

            <div class="add-product-form">
                <form id="productForm">
                    <!-- Product Name -->
                    <div class="form-group">
                        <label for="productName">Product Name </label>
                        <input type="text" id="productName" name="name" placeholder="Enter Product Name" >
                    </div>

                    <!-- Category Dropdown -->
                    <div class="form-group">
                        <label for="category">Category </label>
                        <select id="category" name="category" >
                            <option value="">Select Category</option>
                            <% if (typeof categories !== 'undefined') { %>
                                <% categories.forEach(function(cat) { %>
                                    <% if (cat.isListed) { %>
                                        <option value="<%= cat._id %>"><%= cat.name %></option>
                                    <% } %>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Highlights -->
                    <div class="form-group">
                        <label>Highlights</label>
                        <div id="highlightsContainer">
                            <div class="highlight-wrapper">
                                <input type="text" class="highlight-input" name="highlights" placeholder="Add highlight">
                            </div>
                            <div class="highlight-wrapper">
                                <input type="text" class="highlight-input" name="highlights" placeholder="Add highlight">
                            </div>
                        </div>
                        <button type="button" id="addHighlightBtn">Add Highlight</button>
                    </div>

                  
                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="4" placeholder="Write your description..." ></textarea>
                    </div>

                    <div class="form-group">
                        <button type="button" id="addVariantBtn" class="btn-primary">Add Variant</button>
                    </div>

              
                    <div id="variantsContainer">
                      
                    </div>

                    <div class="form-actions">
                        <button type="button" class="cancel-btn btn-secondary">Cancel</button>
                        <button type="submit" class="save-btn btn-primary">Save Product</button>
                    </div>
                </form>
            </div>
        </main>
    

    <!-- Variant Modal -->
    <div class="modal" id="variantModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Add Variant</h3>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <form id="variantForm">
                    <div class="form-group">
                        <label for="color">Color *</label>
                        <input type="text" id="color" name="color" >
                    </div>
                    <div class="form-group">
                        <label for="price">Price *</label>
                        <input type="number" id="price" name="price" step="0.01" min="0" >
                    </div>
                    <div class="form-group">
                        <label for="discountedPrice">Discount Price</label>
                        <input type="number" id="discountedPrice" name="discountedPrice" step="0.01" min="0">
                    </div>
                    <div class="form-group">
                        <label for="stockLimit">Stock Limit</label>
                        <input type="number" id="stockLimit" name="stockLimit" min="0" >
                    </div>
                    <div class="form-group">
                        <label>Images (Upload exactly 3 images) </label>
                        <div class="image-uploads">
                            <div class="file-upload-group">
                                <label for="image1" class="file-label">Image 1</label>
                                <input type="file" id="image1" name="image1" accept="image/*">
                                <div class="preview-container"></div>
                            </div>
                            <div class="file-upload-group">
                                <label for="image2" class="file-label">Image 2</label>
                                <input type="file" id="image2" name="image2" accept="image/*">
                                <div class="preview-container"></div>
                            </div>
                            <div class="file-upload-group">
                                <label for="image3" class="file-label">Image 3</label>
                                <input type="file" id="image3" name="image3" accept="image/*">
                                <div class="preview-container"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="cancel-btn btn-secondary" id="closeModalBtn">Close</button>
                <button type="button" class="save-btn btn-primary" id="saveVariantBtn">Save Variant</button>
            </div>
        </div>
    </div>
    
    <!-- Image Crop Modal -->
<div class="modal" id="cropModal">
  <div class="modal-content" style="max-width:600px;">
    <div class="modal-header">
      <h3>Crop Image</h3>
      <span class="close" id="closeCropModal">&times;</span>
    </div>
    <div class="modal-body">
      <div style="max-height:400px;">
        <img id="cropImage" style="max-width:100%; display:block;" />
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-secondary" id="cancelCropBtn">Cancel</button>
      <button type="button" class="btn-primary" id="applyCropBtn">Crop & Replace</button>
    </div>
  </div>
</div>

    
    
    
    
    