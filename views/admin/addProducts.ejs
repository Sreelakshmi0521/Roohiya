<main class="main-content">
    <div class="page-header">
        <h1>Add New Product</h1>
    </div>

    <div class="add-product-form">
        <form id="productForm" action="/admin/products/add" method="POST" enctype="multipart/form-data">
            <!-- Product Name -->
            <div class="form-group mb-4">
                <label class="form-label">Product Name <span class="text-danger">*</span></label>
                <input type="text" id="productName" name="name" class="form-control" placeholder="Enter Product Name">
                <small class="text-danger error-message" id="productName-error"></small>
            </div>

            <!-- Category -->
            <div class="form-group mb-4">
                <label class="form-label">Category <span class="text-danger">*</span></label>
                <select id="category" name="category" class="form-control">
                    <option value="">Select Category</option>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat._id %>"><%= cat.name %></option>
                    <% }) %>
                </select>
                <small class="text-danger error-message" id="category-error"></small>
            </div>

            <!-- Highlights -->
            <div class="form-group mb-4">
                <label class="form-label">Highlights</label>
                <div id="highlightsContainer">
                    <div class="highlight-item mb-2">
                        <input type="text" class="form-control highlight-input" name="highlights[]" placeholder="e.g. Premium Quality">
                    </div>
                    <div class="highlight-item mb-2">
                        <input type="text" class="form-control highlight-input" name="highlights[]" placeholder="e.g. Limited Edition">
                    </div>
                </div>
                <button type="button" id="addHighlightBtn" class="btn btn-outline-secondary btn-sm mt-2">+ Add Highlight</button>
            </div>

            <!-- Description -->
            <div class="form-group mb-5">
                <label class="form-label">Description <span class="text-danger">*</span></label>
                <textarea id="description" name="description" class="form-control" rows="6" placeholder="Write a detailed description..."></textarea>
                <small class="text-danger error-message" id="description-error"></small>
            </div>

            <!-- Variants Section -->
            <div class="variants-section mb-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3>Product Variants</h3>
                    <button type="button" id="addVariantBtn" class="btn btn-add">
                        Add Variant
                    </button>
                </div>

                <div id="variantsContainer">
                    <!-- Dynamic variant cards will be inserted here -->
                </div>
                <small class="text-danger error-message" id="variants-error"></small>
            </div>

            <!-- Submit -->
            <div class="form-actions text-center">
                <button type="button" class="btn btn-cancel me-3" onclick="window.history.back()">Cancel</button>
                <button type="submit" id="saveProductBtn" class="btn btn-add">
                    <span class="btn-text">Save Product</span>
                    <span class="btn-spinner hidden">
                        <i class="fas fa-spinner fa-spin"></i> Saving...
                    </span>
                </button>
            </div>
        </form>
    </div>
</main>

<!-- Variant Modal -->
<div id="variantModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add Variant</h3>
            <span class="close">×</span>
        </div>
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Color <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="variantColor">
                    <small class="text-danger error-message" id="variantColor-error"></small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Price (₹) <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="variantPrice" step="0.01" min="0">
                    <small class="text-danger error-message" id="variantPrice-error"></small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Discount Price (₹)</label>
                    <input type="number" class="form-control" id="variantDiscountedPrice" step="0.01" min="0">
                    <small class="text-danger error-message" id="variantDiscountedPrice-error"></small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Stock <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="variantStock" min="0">
                    <small class="text-danger error-message" id="variantStock-error"></small>
                </div>
            </div>

            <div class="mt-4">
                <label class="form-label">Variant Images <span class="text-danger">(Exactly 3 required)</span></label>
                <div class="variant-images" id="modalVariantImages">
                    <% for (let i = 0; i < 3; i++) { %>
                    <div class="image-upload" data-index="<%= i %>">
                        <div class="upload-placeholder">
                            <div class="upload-icon"><i class="fas fa-image"></i></div>
                            <p class="upload-text">Image <%= i + 1 %></p>
                            <button type="button" class="upload-btn">BROWSE IMAGE</button>
                        </div>
                        <div class="image-preview-container hidden">
                            <img class="image-preview" src="#" alt="Preview">
                            <button type="button" class="delete-image-btn">×</button>
                        </div>
                        <input type="file" name="variantImages" accept="image/*" class="file-input">
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-cancel" id="closeVariantModal">Cancel</button>
            <button type="button" class="btn btn-add" id="saveVariantToList">Add to List</button>
        </div>
    </div>
</div>

<!-- Crop Modal -->
<div id="cropModal" class="modal">
    <div class="modal-content crop-modal">
        <div class="modal-header">
            <h3>Crop Image</h3>
            <span class="close">×</span>
        </div>
        <div class="modal-body">
            <div class="crop-container">
                <img id="cropImage" src="#" alt="Image to crop">
            </div>
        </div>
        <div class="modal-footer crop-actions">
            <button type="button" id="cancelCrop" class="btn btn-cancel">Cancel</button>
            <button type="button" id="applyCrop" class="btn btn-add">Apply Crop</button>
        </div>
    </div>
</div>