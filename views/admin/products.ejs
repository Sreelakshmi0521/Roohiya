<div class="content-wrapper">
    <h1>Products</h1>

    <!-- Search and Clear Button -->
    <div class="search-actions">
      <form action="/admin/products" method="GET" class="search-form">
        <input type="text" name="search" value="<%= search %>" placeholder="Search here" class="search-input">
        <button type="submit" class="btn btn-search">🔍</button>
        <div class="clear-container">
          <a href="/admin/products" class="btn btn-clear">Clear</a>
        </div>
      </form>
    </div>

    <!-- Add Product Button -->
    <div class="add-action">
      <a href="/admin/products/add" class="btn btn-add">+ Add Product</a>
    </div>

    <!-- Product Table -->
    <div class="table-wrapper">
      <table class="products-table table">
        <thead>
          <tr>
            <th>Sl.No</th>
            <th>Image</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Status</th>
            <th>Total Stock</th>
            <th>Quick Actions</th>
            <th>Added On</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
  <% if (products.length === 0) { %>
    <tr>
      <td colspan="9" class="no-results">No products found</td>
    </tr>
  <% } else { %>
    <% for(let i = 0; i < products.length; i++) { 
      let product = products[i]; 
      let index = (currentPage - 1) * perPage + i + 1; %>

      <tr>
        <td><%= index %></td>

         <td>
    <% if (product.previewImage) { %>
      <img src="<%= product.previewImage %>" alt="Preview" class="preview-thumb">
    <% } else { %>
      <span style="color:#aaa;">No Image</span>
    <% } %>
  </td>

        <td><%= product.name %></td>

        <td>
          <% if (product.category && product.category.name) { %>
            <%= product.category.name %>
          <% } else { %>
            No Category
          <% } %>
        </td>

        <td>
          <span class="status <%= product.isListed ? 'listed' : 'unlisted' %>">
            <%= product.isListed ? 'Listed' : 'Unlisted' %>
          </span>
        </td>

        <td>
          <% if (product.totalStock !== undefined) { %>
            <%= product.totalStock %>
          <% } else { %>
            0
          <% } %>
        </td>

        <td class="action-cell">
          <div class="button-group">
            <a href="/admin/products/variants/<%= product._id %>" class="btn btn-variant">
              <span class="btn-icon"></span> Variant
            </a>
          </div>
        </td>

        <td>
          <% if (product.createdAt) { %>
            <%= product.createdAt.toLocaleDateString() %>
          <% } else { %>
            N/A
          <% } %>
        </td>

        <td class="action-cell">
          <div class="button-group">
            <a href="/admin/products/edit/<%= product._id %>" class="btn btn-edit">
              <span class="btn-icon"></span> Edit
            </a>
            <button class="toggle-btn" 
                    data-id="<%= product._id %>" 
                    data-status="<%= product.isListed %>" 
                    data-type="product">
              <%= product.isListed ? 'Unlist' : 'List' %>
            </button>
          </div>
        </td>
      </tr>
    <% } %>
  <% } %>
</tbody>

      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination">
      <% if(currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %>&search=<%= search %>" class="btn prev-btn">Previous</a>
      <% } %>
      
      <% for(let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>&search=<%= search %>" class="btn page-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>

      <% if(currentPage < totalPages) { %>
        <a href="?page=<%= currentPage + 1 %>&search=<%= search %>" class="btn next-btn">Next</a>
      <% } %>
    </div>
</div>