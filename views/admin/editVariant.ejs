<main class="content-area">
    <div class="add-product-container">
        <h2 class="page-title">Edit Variant</h2>

        <% if (message) { %>
            <div class="alert alert-<%= messageType === 'success' ? 'success' : messageType === 'error' ? 'danger' : 'warning' %> mb-4">
                <%- message %>
            </div>
        <% } %>

        <form id="editVariantForm" enctype="multipart/form-data" method="POST" action="/admin/products/variants/edit/<%= variant._id %>">
            <div class="mb-3">
                <label class="form-label">Color <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="color" id="color" value="<%= variant.color %>" required>
                <small class="text-danger error-message" id="color-error"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Price (₹) <span class="text-danger">*</span></label>
                <input type="number" class="form-control" name="price" id="price" step="0.01" min="0" value="<%= variant.price %>" required>
                <small class="text-danger error-message" id="price-error"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Discount Price (₹)</label>
                <input type="number" class="form-control" name="discountedPrice" id="discountedPrice" step="0.01" min="0"
                       value="<%= variant.discountedPrice || '' %>">
                <small class="text-danger error-message" id="discountedPrice-error"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Stock <span class="text-danger">*</span></label>
                <input type="number" class="form-control" name="stock" id="stock" min="0" value="<%= variant.stock %>" required>
                <small class="text-danger error-message" id="stock-error"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Variant Images <span class="text-muted">(Click any image to replace it individually)</span></label>
                <div class="variant-images" id="variantImagesContainer">
                    <% variant.images.forEach((image, i) => { %>
                    <div class="image-upload" data-index="<%= i %>">
                        <!-- Current / Preview Image -->
                        <div class="image-preview-container">
                            <img class="image-preview" src="<%= image %>" alt="Image <%= i + 1 %>">
                            <button type="button" class="delete-image-btn" aria-label="Remove new image">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <!-- Placeholder (shown when image is removed or to trigger upload) -->
                        <div class="upload-placeholder hidden">
                            <div class="upload-icon"><i class="fas fa-image"></i></div>
                            <div class="upload-text">Replace Image <%= i + 1 %></div>
                            <button type="button" class="upload-btn">BROWSE IMAGE</button>
                        </div>

                        <!-- Individual file input with index -->
                        <input type="file" name="variantImages[<%= i %>]" accept="image/*" class="file-input">
                    </div>
                    <% }) %>
                </div>
                <small class="text-muted">
                    Upload a new image for any slot to replace only that one. Leave untouched to keep current image.
                </small>
            </div>

            <div class="submit-section">
                <button type="submit" id="saveVariantBtn" class="btn btn-add">
                    <span class="btn-text">Update Variant</span>
                    <span class="btn-spinner hidden">
                        <i class="fas fa-spinner fa-spin"></i> Saving...
                    </span>
                </button>
                <button type="button" class="btn btn-cancel" onclick="window.history.back()">Cancel</button>
            </div>
        </form>
    </div>
</main>

<!-- Crop Modal -->
<div id="cropModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Crop Image</h3>
            <span class="close">×</span>
        </div>
        <div class="modal-body">
            <div class="crop-container">
                <img id="cropImage" src="#" alt="Image to crop">
            </div>
            <div class="crop-actions">
                <button type="button" id="cancelCrop" class="btn btn-cancel">Cancel</button>
                <button type="button" id="applyCrop" class="btn btn-add">Apply Crop</button>
            </div>
        </div>
    </div>
</div>