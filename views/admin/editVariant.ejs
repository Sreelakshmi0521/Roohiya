<div class="admin-container">
  <div class="page-header">
    <h1>Edit Variant</h1>
  

  <form action="/admin/products/variants/edit/<%= variant._id %>" method="POST" enctype="multipart/form-data">
  

    <div class="form-group">
      <label for="color">Color</label>
      <input type="text" id="color" name="color" value="<%= variant.color %>" >
    </div>

    <div class="form-group">
      <label for="price">Price</label>
      <input type="number" id="price" name="price" value="<%= variant.price %>" step="0.01" >
    </div>

    <div class="form-group">
      <label for="discountedPrice">Discounted Price</label>
      <input type="number" id="discountedPrice" name="discountedPrice" value="<%= variant.discountedPrice %>" step="0.01">
    </div>

    <div class="form-group">
      <label for="stock">Stock</label>
      <input type="number" id="stock" name="stock" value="<%= variant.stock %>" min="0" >
    </div>

    <div class="form-group">
      <label for="images">Images (Upload to replace existing images)</label>
      <input type="file" id="images" name="images" multiple accept="image/*">
      <div class="images-preview" id="imagesPreview">
        <% if (variant.images && variant.images.length > 0) { %>
          <% variant.images.forEach(function(img, i) { %>
            <img src="<%= img %>" class="preview-image" alt="Existing Image <%= i+1 %>">
          <% }) %>
        <% } else { %>
          <p class="no-images">No images selected.</p>
        <% } %>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Variant</button>
      <a href="/admin/products/variants/<%= productId || product._id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const imagesInput = document.getElementById('images');
    const imagesPreview = document.getElementById('imagesPreview');
    const form = document.querySelector('form');
    const updateButton = form.querySelector('button[type="submit"]');
    const MAX_IMAGES = 3;

    function showToast(message, type = 'warning') {
        const bgColor = type === 'success' ? '#4CAF50' : '#FF6B6B';
        Toastify({
            text: message,
            duration: 3000,
            close: true,
            gravity: 'top',
            position: 'right',
            backgroundColor: bgColor
        }).showToast();
    }
    function resetPreview() {
        imagesPreview.innerHTML = '<p class="no-images">No images selected. Please upload 3 images.</p>';
    }
    if (imagesInput) {
        imagesInput.addEventListener('change', function() {
            const files = this.files;

            if (!files || files.length === 0) {
                if (!imagesPreview.querySelector('img')) resetPreview();
                return;
            }

            if (files.length > MAX_IMAGES) {
                showToast(`You can only upload exactly ${MAX_IMAGES} images.`);
                this.value = '';
                return;
            }

            if (files.length < MAX_IMAGES) {
                showToast(`You must upload exactly ${MAX_IMAGES} images.`);
                this.value = '';
                return;
            }


            imagesPreview.innerHTML = '';

            for (let i = 0; i < files.length; i++) {
                const file = files[i];

                if (!file.type.match('image.*')) {
                    showToast('Only image files (jpg, jpeg, png) are allowed.');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'preview-image';
                    img.alt = 'Preview Image ' + (i + 1);
                    imagesPreview.appendChild(img);
                }
                reader.readAsDataURL(file);
            }
        });
    }

  
    form.addEventListener('submit', function(e) {
        updateButton.disabled = true;
        updateButton.innerHTML = 'Updating Variant... <span class="spinner"></span>';
        showToast('Updating variant, please wait...', 'success');
    })
})
</script>
