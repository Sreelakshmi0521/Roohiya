<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }
    .error-container {
      text-align: center;
    }
    .error-container h1 {
      font-size: 120px;
      color: #364a63;
    }
    .error-container p {
      font-size: 20px;
      margin-bottom: 20px;
    }
    .error-container a {
      background-color: #364a63;
      color: #fff;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
    }
    .error-container a:hover {
      background-color: #364a63;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <h1>404</h1>
    <p>Oops! Page not found in Admin Panel.</p>
    <a href="/admin/dashboard">Back to Dashboard</a>
  </div>
</body>
</html>
