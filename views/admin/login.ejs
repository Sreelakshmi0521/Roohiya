<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: black;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .container {
            display: flex;
            background-color: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        .logo-section {
            width: 300px;
            display: flex;
            justify-content: center;
            align-items: center;
            /* background-color: #ffe6e6; */
        }
        .logo-section img {
            width: 250px;
             border-radius: 130px; 
        }
        .form-section {
            padding: 40px;
            width: 300px;
            text-align: center;
        }
        .form-section h2 {
            margin-bottom: 20px;
            color: #333;
        }
        .form-section input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .form-section button {
            width: 100%;
            padding: 10px;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .form-section button:hover {
            background-color: #0056b3;
        }
        .form-section .footer-text {
            margin-top: 20px;
            font-size: 12px;
            color: #999;
        }
        .alert {
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
            text-align: left;
        }
        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo-section">
            <img src="/images/logo.jpg" alt="Roohiya Logo">
        </div>
        <div class="form-section">
            <h2>ADMIN LOGIN</h2>
       
            <form id="loginForm" action="/admin/login" method="POST" novalidate>
                <input type="email" name="email" placeholder="Email" id="email" value="roohiya@gmail.com" >
                <input type="password" name="password" placeholder="Password" id="password" value="roohiya">
                <button type="submit">Sign in</button>
            </form>
            <p class="footer-text">Roohiya</p>
        </div>
    </div>
    
<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

   <script>
document.getElementById('loginForm').addEventListener('submit', function(e) {
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value.trim();

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!email || !emailPattern.test(email)) {
        e.preventDefault();
        Toastify({
            text: "Please enter a valid email address",
            duration: 1000,
            gravity: "top", // top or bottom
            position: "center",
              offset: {
        x: 0, // horizontal
        y: 50 // vertical distance from top
    }, // left, center or right
            backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
        }).showToast();
        return;
    }

    if (!password || password.length < 6) {
        e.preventDefault();
        Toastify({
            text: "Password must be at least 6 characters",
            duration: 1000,
            gravity: "top",
            position: "center",
              offset: {
        x: 0, 
        y: 50 
    },
            backgroundColor: "linear-gradient(to right, #f12711, #f5af19)",
        }).showToast();
        return;
    }
});
</script>


</body>
</html>