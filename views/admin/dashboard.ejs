                                    <div class="pie-chart">
                                        <canvas id="orderChart"></canvas>
                                    </div>
                                    <div class="pie-label">Total Orders<br><strong>82%</strong></div>
                                </div>
                                <div>
                                    <div class="pie-chart">
                                        <canvas id="customerChart"></canvas>
                                    </div>
                                    <div class="pie-label">Customer Growth<br><strong>33%</strong></div>
                                </div>
                                <div>
                                    <div class="pie-chart">
                                        <canvas id="couponChart"></canvas>
                                    </div>
                                    <div class="pie-label">Coupon Growth<br><strong>17%</strong></div>
                                </div>
                            </div>
                        </div>

                        <div class="chart-card product-bar">
                            <h3>Products Sold</h3>
                            <canvas id="barChart"></canvas>
                        </div>
                    </div>

                    <div class="chart-card revenue-chart">
                        <h3>Total Revenue</h3>
                        <canvas id="lineChart"></canvas>
                    </div>

                    <div class="footer">
                        © 2025 Roopiya. All rights reserved.
                    </div>
                </div>

                

            

               

           


