<div class="content-wrapper">
    <h1>Customers</h1>
    <div class="search-filter-bar">
        <div class="search-container">
            <input type="text" class="search-input" placeholder="Search here...">
            <span class="search-icon">🔍</span>
        </div>
        <select class="filter-select">
            <option value="">Filters</option>
            <option value="active">Active</option>
            <option value="blocked">Blocked</option>
        </select>
    </div>
    <table class="customer-table table">
        <thead>
            <tr>
                <th>Customer ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td><%= customer._id %></td> <!-- Changed from customer.customerId to customer._id -->
                    <td><%= customer.name %></td>
                    <td><%= customer.email %></td>
                    <td><%= customer.phone %></td>
                    <td><%= customer.status %></td>
                    <td>
                        <a href="/admin/edit/<%= customer._id %>" class="btn btn-edit">edit</a> <!-- Updated to use _id -->
                        <a href="/admin/delete/<%= customer._id %>" class="btn btn-delete">delete</a> <!-- Updated to use _id -->
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    <div class="pagination">
        <button class="btn prev-btn">Previous</button>
        <span class="page-numbers">
            <% for(let i = 1; i <= totalPages; i++) { %>
                <button class="btn page-btn <%= currentPage === i ? 'active' : '' %>" data-page="<%= i %>"><%= i %></button>
            <% } %>
        </span>
        <button class="btn next-btn">Next</button>
    </div>
</div>