<div class="content-wrapper">
    <h1>Categories</h1>

    <!-- Search (right aligned, short) -->
    <form action="/admin/categories" method="GET" class="search-filter-form">
        <div class="search-container-right">
            <input type="text" name="search" value="<%= search %>" placeholder="Search..." class="search-input">
            <button type="submit" class="btn btn-search">🔍</button>
            <a href="/admin/categories" class="btn btn-clear">Clear</a>
        </div>
    </form>

    <!-- Category Table -->
    <table class="category-table table">
        <thead>
            <tr>
                <th>Sl.No</th>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        <% if(categories.length === 0) { %>
            <tr>
                <td colspan="5" class="no-results">No categories found</td>
            </tr>
        <% } else { %>
            <% for(let i = 0; i < categories.length; i++) { 
                let category = categories[i]; %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= category.name %></td>
                    <td><%= category.description %></td>
                    <td><%= category.isListed ? "Listed" : "Unlisted" %></td>
                    <td>
                        <!-- Edit -->
                        <a href="/admin/categories/edit/<%= category._id %>" class="btn btn-edit">Edit</a>
                        
                        <!-- List / Unlist toggle -->
                        <a href="#" 
                            class="btn toggle-btn <%= category.isListed ? 'btn-unlist' : 'btn-list' %>" 
                            data-id="<%= category._id %>" 
                            data-status="<%= category.isListed %>">
                            <%= category.isListed ? 'Unlist' : 'List' %>
                         </a>

                    </td>
                </tr>
            <% } %>
        <% } %>
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="pagination">
        <% if(currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&search=<%= search %>" class="btn prev-btn">Previous</a>
        <% } %>
        
        <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>&search=<%= search %>" class="btn page-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <% if(currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&search=<%= search %>" class="btn next-btn">Next</a>
        <% } %>
    </div>

    <!-- Bottom Add Button -->
    <div class="category-actions">
        <a href="/admin/categories/add" class="btn btn-add">+ Add Category</a>
    </div>
</div>
