<div class="content-wrapper">
    <h1>Edit Category</h1>

    <!-- Edit Category Form -->
    <form action="/admin/categories/edit/<%= category._id %>?_method=PUT" method="POST" class="category-form">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input type="text" id="name" name="name" placeholder="Enter category name" value="<%= formData ? formData.name : category.name %>">

        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="Enter description"><%= formData ? formData.description : category.description %></textarea>
        </div>

        <button type="submit" class="btn btn-edit">Update Category</button>
        <a href="/admin/categories" class="btn btn-clear">Cancel</a>
    </form>
</div>
