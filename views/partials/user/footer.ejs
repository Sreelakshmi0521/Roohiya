<footer>
  <div class="footer-content">
    <!-- Brand Section -->
    <div class="footer-section">
      <h3>Roohiya</h3>
      <p>Timeless jewelry for every occasion</p>
      <div class="social-icons">
        <a href="#"><i class="fab fa-facebook-f"></i></a>
        <a href="#"><i class="fab fa-instagram"></i></a>
        <a href="#"><i class="fab fa-pinterest-p"></i></a>
      </div>
    </div>

    <!-- Shop Section -->
    <div class="footer-section">
      <h4>Shop</h4>
      <ul>
        <li><a href="/user/shop">All Products</a></li>
        <li><a href="/user/new-arrivals">New Arrivals</a></li>

        <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
          <% 
            const casualCategory = categories.find(cat => (cat.name || (cat._doc && cat._doc.name))?.toLowerCase().includes('casual'));
            const festiveCategory = categories.find(cat => (cat.name || (cat._doc && cat._doc.name))?.toLowerCase().includes('festive'));
            const officeCategory = categories.find(cat => (cat.name || (cat._doc && cat._doc.name))?.toLowerCase().includes('office'));
          %>
          <% if (casualCategory) { %>
            <li><a href="/user/shop?category=<%= casualCategory._id %>">Casual Wear</a></li>
          <% } %>
          <% if (festiveCategory) { %>
            <li><a href="/user/shop?category=<%= festiveCategory._id %>">Festive Wear</a></li>
          <% } %>
          <% if (officeCategory) { %>
            <li><a href="/user/shop?category=<%= officeCategory._id %>">Office Wear</a></li>
          <% } %>
        <% } else { %>
          <li><a href="/user/shop">Casual Wear</a></li>
          <li><a href="/user/shop">Festive Wear</a></li>
          <li><a href="/user/shop">Office Wear</a></li>
        <% } %>
      </ul>
    </div>

    <!-- Information Section -->
    <div class="footer-section">
      <h4>Information</h4>
      <ul>
        <li><a href="/user/about">About Us</a></li>
        <li><a href="/user/contact">Contact Us</a></li>
        <li><a href="/user/terms">Terms & Conditions</a></li>
        <li><a href="/user/privacyPolicy">Privacy Policy</a></li>
        <li><a href="/user/shipping">Shipping Info</a></li>
        <li><a href="/user/returns">Returns</a></li>
      </ul>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <p>&copy; 2025 Roohiya. All rights reserved.</p>
  </div>
</footer>
