<div class="profile-sidebar">
  <div class="profile-image-section">
    <div class="profile-image">
        <img src="<%= user.profileImage || '/images/default-profile.png' %>" alt="Profile Image">
    </div>
    <h2><%= user.name %></h2>
  </div>

  <nav class="profile-nav">
    <ul>
      <li>
        <a href="/user/profile" class="nav-link <%= activePage === 'profile' ? 'active' : '' %>">Personal Details</a>
      </li>
      <li>
        <a href="/user/addresses" class="nav-link <%= activePage === 'addresses' ? 'active' : '' %>">Address</a>
      </li>
      <li>
        <a href="/user/orders" class="nav-link <%= activePage === 'orders' ? 'active' : '' %>">My Orders</a>
      </li>
      <% if (!user.isGoogleUser) { %>
      <li>
        <a href="/user/changePassword" class="nav-link <%= activePage === 'changePassword' ? 'active' : '' %>">Change Password</a>
      </li>
      <% } %>
    </ul>
  </nav>
</div>
