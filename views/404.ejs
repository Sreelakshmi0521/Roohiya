<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | Roohiya</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* ===== Global Styles ===== */
    body {
      background-color: #f8f9fa;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* ===== Error Container ===== */
    .error-container {
      text-align: center;
      padding: 20px;
    }

    .error-container h1 {
      font-size: 120px;
      color: #d4af37;
      font-weight: bold;
    }

    .error-container h2 {
      font-size: 28px;
      color: #555;
      margin-bottom: 15px;
    }

    .error-container p {
      font-size: 18px;
      color: #666;
      margin-bottom: 25px;
    }

    /* ===== Back to Home Button ===== */
    .error-container a {
      background-color: #d4af37;
      color: #fff;
      padding: 10px 25px;
      border-radius: 5px;
      text-decoration: none;
      font-weight: 500;
      transition: background-color 0.3s ease;
    }

    .error-container a:hover {
      background-color: #d4af37;
    }

    /* ===== Responsive ===== */
    @media (max-width: 576px) {
      .error-container h1 {
        font-size: 80px;
      }
      .error-container h2 {
        font-size: 22px;
      }
      .error-container p {
        font-size: 16px;
      }
    }
  </style>
</head>
<body>
  <div class="error-container">
    <h1>404</h1>
    <h2>Oops! Page Not Found</h2>
    <p>Looks like the page you’re trying to visit doesn’t exist or has been moved.</p>
    <a href="/">Back to Home</a>
  </div>
</body>
</html>
